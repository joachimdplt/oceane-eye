# Configuration de déploiement — copier en .env.deploy SUR LE VPS.
# CE FICHIER NE DOIT JAMAIS ÊTRE COMMITÉ AVEC DE VRAIES VALEURS.
#
#   cp .env.deploy.example .env.deploy && nano .env.deploy
#   docker compose -f docker-compose.prod.yml --env-file .env.deploy up -d --build
#   ./deploy/install-site.sh

# Nom du stack : préfixe des conteneurs et alias réseau. Unique sur la machine.
STACK=ocean-eye

# Domaine servi. Les DNS doivent pointer sur le VPS AVANT le premier démarrage,
# sinon Caddy ne peut pas obtenir le certificat.
# ⚠ À renseigner : la même valeur doit être reportée dans SITE_URL
#   (src/utils/seo.ts), public/robots.txt et public/sitemap.xml.
APP_DOMAIN=ocean-eye.fr
