# Configuration d'un front SSR seul — copier en .env.deploy SUR LE VPS.
# CE FICHIER NE DOIT JAMAIS ÊTRE COMMITÉ AVEC DE VRAIES VALEURS.
#
#   cp .env.deploy.example .env.deploy && nano .env.deploy
#   docker compose -f docker-compose.prod.yml --env-file .env.deploy up -d --build
#   ./deploy/install-site.sh

# Unique sur la machine, égal au nom du dossier sous /opt (conventions § 3).
#   oceaneye-dev   →  le site de test
#   oceaneye-prod  →  la mise en ligne, le jour venu
STACK=oceaneye-dev

# Domaine du site. Le DNS doit pointer sur le VPS AVANT le premier `up`.
#
# Écart assumé au § 10 : la convention veut un domaine par environnement sous le
# domaine du site. Ocean Eye n'a pas encore le sien, donc l'environnement de test
# est hébergé sous celui de somekind. À la mise en ligne, ce sera la racine du
# vrai domaine — et il faudra reporter la valeur dans SITE_URL (src/utils/seo.ts)
# et repasser INDEXABLE à true.
APP_DOMAIN=oceaneye.somekind.fr

# Ce site ne consomme aucune API : les variables PUBLIC_API_URL et
# SERVER_API_URL du gabarit `ssr-seul` n'ont pas lieu d'être ici.
