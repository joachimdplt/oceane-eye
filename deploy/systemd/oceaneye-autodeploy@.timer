# Gabarit de timer d'autodeploy. Renommer comme le .service correspondant
# (<app>-autodeploy@.timer) : les deux noms doivent concorder, sinon le timer ne
# trouve pas son unité.
[Unit]
Description=Surveille le dépôt de %i et déploie les nouveaux commits

[Timer]
# Deux minutes : assez court pour qu'un push se voie presque tout de suite,
# assez espacé pour que la vérification (un git fetch) reste négligeable.
OnBootSec=2min
OnUnitActiveSec=2min
# À adapter au nom de l'unité de service : <app>-oceaneye-autodeploy@%i.service
Unit=CHANGEZ-MOI-oceaneye-autodeploy@%i.service

[Install]
WantedBy=timers.target
