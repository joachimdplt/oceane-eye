# L'instance (%i) est le NOM DU DOSSIER sous /opt, donc le STACK :
#
#   systemctl enable --now ocean-eye-autodeploy@somekind.timer
[Unit]
Description=Déploiement automatique de %i
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/%i
ExecStart=/opt/%i/deploy/autodeploy.sh
# Un déploiement (build de l'image) dure plus longtemps que l'intervalle du
# timer. systemd ne relance pas une unité déjà en cours d'exécution : le
# déclenchement suivant est simplement ignoré, sans chevauchement possible.
TimeoutStartSec=1800
